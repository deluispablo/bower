# Static-assets headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# Static files bypass the Worker, so the app's own pages carry their policy here; the Worker
# sets the same four on its answers (api/src/security.ts). The test in src/docs.test.ts reads this file.
#
# Origins the app allows, and why:
#   'self'                         the app, its service worker, and the Worker (one origin, TL-P3-06)
#   https://www.googleapis.com     Drive calls from the browser (src/data/drive)
#   https://fonts.googleapis.com   the font stylesheet (index.html)
#   https://fonts.gstatic.com      the font files
#   data: blob: (images only)      inline icons and previews
#   'sha256-...'                   the one inline script in index.html (the saved theme); regenerate if it changes
#   style 'unsafe-inline'          React style attributes cannot be hashed; styles cannot run code
# Sign-in is a full-page redirect to Google, which a CSP does not limit.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-0dnUyfm8Ac6VatwJdxhV4pIBwhw3IYzVlR04RW7U/2I='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://www.googleapis.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The landing is exported from the design canvas and runs its page script through new Function,
# so it alone needs 'unsafe-eval'. It makes no calls and has no inline script. Detach, then set its own.
/landing/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
