{
  "name": "bower-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tokens": "node scripts/tokens-to-css.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile=test-results/unit.json",
    "e2e": "bash testing/with-lock.sh playwright test",
    "check": "bash testing/with-lock.sh pnpm check:run",
    "check:run": "pnpm lint && pnpm typecheck && pnpm test && pnpm -C api lint && pnpm -C api typecheck && pnpm -C api test && pnpm -C runner lint && pnpm -C runner typecheck && pnpm -C runner test && pnpm -C runner build && pnpm build && node scripts/check-duplication-gate.mjs && node scripts/check-unused-gate.mjs && node scripts/check-dependencies.mjs && node scripts/check-bundle.mjs && node scripts/fix-landing.mjs --check",
    "e2e:fake": "E2E_SOURCE=fake bash testing/with-lock.sh playwright test",
    "e2e:pwa": "bash testing/with-lock.sh pnpm e2e:pwa:run",
    "e2e:pwa:run": "pnpm build && playwright test -c e2e/pwa.config.ts",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "cmdk": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "4.10.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.0",
    "jsdom": "^30.1.1",
    "knip": "6.40.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
