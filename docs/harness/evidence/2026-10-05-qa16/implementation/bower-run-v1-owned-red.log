:"2026-09-01T11:39:48.283Z"},"trashed":false,"content":null},{"meta":{"id":"f65","name":"Payslip August.pdf","folder":false,"parents":["f64"],"modifiedTime":"2026-09-01T11:39:48.283Z","createdTime":"2026-08-31T11:39:48.283Z","size":48},"trashed":false,"content":{"text":"A made-up pdf for the demo: Payslip August.pdf.\n"}},{"meta":{"id":"f66","name":"Payslip September.pdf","folder":false,"parents":["f64"],"modifiedTime":"2026-10-01T12:39:48.283Z","createdTime":"2026-09-30T12:39:48.283Z","size":51},"trashed":false,"content":{"text":"A made-up pdf for the demo: Payslip September.pdf.\n"}},{"meta":{"id":"f67","name":"Budget 2026.md","folder":false,"parents":["f55"],"modifiedTime":"2026-09-27T17:39:48.283Z","createdTime":"2026-09-26T17:39:48.283Z","size":443},"trashed":false,"content":{"text":"---\nsummary: Monthly budget for 2026: rent, bills, food and £600 savings a month.\ntags: [money]\nkind: Budget\nyear: 2026\n---\n\n## Current state\n- September came in £120 under budget, mostly on groceries.\n\n## Each month\n\n| | Planned |\n| --- | --- |\n| Rent | £1,450 |\n| Bills | £180 |\n| Food | £400 |\n| Savings | £600 |\n\n## October\n\n- [x] Move £600 to savings\n- [ ] Cancel the old gym membership\n\n## Timeline\n- 4 Oct · September receipts counted.\n"}},{"meta":{"id":"f68","name":"Health","folder":true,"parents":["f45"],"modifiedTime":"2026-09-05T17:39:48.283Z","createdTime":"2026-09-05T17:39:48.283Z"},"trashed":false,"content":null},{"meta":{"id":"f69","name":"Health.md","folder":false,"parents":["f68"],"modifiedTime":"2026-09-05T17:39:48.283Z","createdTime":"2026-09-04T17:39:48.283Z","size":303,"appProperties":{"by":"bower"}},"trashed":false,"content":{"text":"---\nsummary: GP, dentist, blood tests and the physio routine.\ntags: [health]\nby: bower\nkind: Area\n---\n\n## Current state\n- Dentist check-up on 14 October.\n- Blood test in May was normal.\n\nPhysio routine in [[Physio exercises]].\n\n## Timeline\n- 20 May · Blood test results filed. · [[Blood test, May.pdf]]\n"}},{"meta":{"id":"f70","name":"Blood test, May.pdf","folder":false,"parents":["f68"],"modifiedTime":"2026-05-28T10:39:48.283Z","createdTime":"2026-05-27T10:39:48.283Z","size":49},"trashed":false,"content":{"text":"A made-up pdf for the demo: Blood test, May.pdf.\n"}},{"meta":{"id":"f71","name":"Physio exercises.md","folder":false,"parents":["f68"],"modifiedTime":"2026-08-21T11:39:48.283Z","createdTime":"2026-08-20T11:39:48.283Z","size":223},"trashed":false,"content":{"text":"---\nsummary: Daily knee exercises from the physio, 10 minutes.\ntags: [health]\nkind: Routine\n---\n\n## Every morning\n\n- [x] Wall sit, 3 × 30 s\n- [x] Step-ups, 2 × 12\n- [ ] Single-leg balance, 3 × 30 s\n- [ ] Stretch, 2 minutes\n"}},{"meta":{"id":"f72","name":"Documents","folder":true,"parents":["f45"],"modifiedTime":"2026-09-20T12:39:48.283Z","createdTime":"2026-09-20T12:39:48.283Z"},"trashed":false,"content":null},{"meta":{"id":"f73","name":"Passport copy.pdf","folder":false,"parents":["f72"],"modifiedTime":"2026-08-06T16:39:48.283Z","createdTime":"2026-08-05T16:39:48.283Z","size":47},"trashed":false,"content":{"text":"A made-up pdf for the demo: Passport copy.pdf.\n"}},{"meta":{"id":"f74","name":"Passport renewal.md","folder":false,"parents":["f72"],"modifiedTime":"2026-09-20T12:39:48.283Z","createdTime":"2026-09-19T12:39:48.283Z","size":576,"appProperties":{"by":"bower"}},"trashed":false,"content":{"text":"---\nsummary: Documents for the passport renewal due in March: 4 of 7 ready.\nstatus: in progress\ntags: [documents]\nby: bower\nkind: Checklist\ndue: 1 Mar\n---\n\n## Current state\n- 4 of 7 things ready.\n- The witness for the photo form must have known Alex for two years.\n\n## To send\n\n- [x] Old passport\n- [x] Two new photos\n- [x] Proof of address\n- [x] Application form, filled in\n- [ ] Photo form signed by a witness\n- [ ] Fee paid\n- [ ] Appointment booked\n\n## Timeline\n- 5 Aug · Passport copy filed; numbers left out. · [[Passport copy.pdf]]\n- 4 Oct · Application form filled in.\n"}},{"meta":{"id":"f75","name":"Resources","folder":true,"parents":["f1"],"modifiedTime":"2026-10-05T18:39:48.283Z","createdTime":"2025-08-31T18:39:48.283Z"},"trashed":false,"content":null},{"meta":{"id":"f76","name":"Ideas","folder":true,"parents":["f75"],"modifiedTime":"2026-09-25T14:39:48.283Z","createdTime":"2026-09-25T14:39:48.283Z"},"trashed":false,"content":null},{"meta":{"id":"f77","name":"Weekend projects.md","folder":false,"parents":["f76"],"modifiedTime":"2026-09-25T14:39:48.283Z","createdTime":"2026-09-24T14:39:48.283Z","size":189},"trashed":false,"content":{"text":"---\nsummary: Small things to do on free weekends.\nkind: List\n---\n\n- [ ] Fix the bike's back brake\n- [x] Print the Saltmere photos\n- [ ] Shelf for the hallway\n- [ ] Try the sourdough recipe\n"}},{"meta":{"id":"f78","name":"Cooking","folder":true,"parents":["f75"],"modifiedTime":"2026-10-04T11:39:48.283Z","createdTime":"2026-10-04T11:39:48.283Z"},"trashed":false,"content":null},{"meta":{"id":"f79","name":"Lemon tart.md","folder":false,"parents":["f78"],"modifiedTime":"2026-09-02T18:39:48.283Z","createdTime":"2026-09-01T18:39:48.283Z","size":170},"trashed":false,"content":{"text":"---\nsummary: A lemon tart for six, written down from a friend.\ntags: [recipe]\nkind: Recipe\n---\n\nBlind-bake the case 15 minutes; the filling sets in 25 minutes at 160 °C.\n"}},{"meta":{"id":"f80","name":"Weeknight curry.md","folder":false,"parents":["f78"],"modifiedTime":"2026-10-04T11:39:48.283Z","createdTime":"2026-10-03T11:39:48.283Z","size":491,"appProperties":{"by":"bower","bowerNew":"1"}},"trashed":false,"content":{"text":"---\nsummary: A 30-minute chickpea and spinach curry for four.\ntags: [recipe, vegetarian]\nby: bower\nkind: Recipe\ntime: 30 min\nserves: 4\n---\n\n## Ingredients\n\n- [ ] 2 tins of chickpeas\n- [ ] 200 g spinach\n- [ ] 1 tin of coconut milk\n- [ ] Curry paste, onion, garlic\n\n## Method\n\n1. Soften the onion and garlic.\n2. Fry the paste for a minute.\n3. Add chickpeas and coconut milk; simmer 15 minutes.\n4. Stir in the spinach.\n\n## Timeline\n- Today · Saved from a clipping. · [[curry-clipping.example]]\n"}},{"meta":{"id":"f81","name":"Sourdough, the short version.md","folder":false,"parents":["f78"],"modifiedTime":"2026-09-10T08:39:48.283Z","createdTime":"2026-09-09T08:39:48.283Z","size":322,"appProperties":{"by":"bower"}},"trashed":false,"content":{"text":"---\nsummary: A same-day sourdough loaf, 7 hours from mixing to baking.\ntags: [recipe, baking]\nby: bower\nkind: Recipe\ntime: 7 h\n---\n\n1. Mix 500 g flour, 350 g water, 100 g starter, 10 g salt.\n2. Four folds, 30 minutes apart.\n3. Shape, rest 2 hours, bake 45 minutes at 240 °C.\n\n## Timeline\n- 9 Sep · Saved from a blog post.\n"}},{"meta":{"id":"f82","name":"Manuals","folder":true,"parents":["f75"],"modifiedTime":"2026-07-07T15:39:48.283Z","createdTime":"2026-07-07T15:39:48.283Z"},"trashed":false,"content":null},{"meta":{"id":"f83","name":"Router setup.pdf","folder":false,"parents":["f82"],"modifiedTime":"2026-06-07T14:39:48.283Z","createdTime":"2026-06-06T14:39:48.283Z","size":46},"trashed":false,"content":{"text":"A made-up pdf for the demo: Router setup.pdf.\n"}},{"meta":{"id":"f84","name":"Dishwasher manual.pdf","folder":false,"parents":["f82"],"modifiedTime":"2026-07-07T15:39:48.283Z","createdTime":"2026-07-06T15:39:48.283Z","size":51},"trashed":false,"content":{"text":"A made-up pdf for the demo: Dishwasher manual.pdf.\n"}},{"meta":{"id":"f85","name":"Reading","folder":true,"parents":["f75"],"modifiedTime":"2026-08-06T16:39:48.283Z","createdTime":"2026-08-06T16:39:48.283Z"},"trashed":false,"content":null},{"meta":{"id":"f86","name":"Notes that grow.md","folder":false,"parents":["f85"],"modifiedTime":"2026-08-06T16:39:48.283Z","createdTime":"2026-08-05T16:39:48.283Z","size":233},"trashed":false,"content":{"text":"---\nsummary: Notes on the book: write in your own words and link each note to others.\ntags: [reading]\nkind: Book\nauthor: Ida Marrow\n--