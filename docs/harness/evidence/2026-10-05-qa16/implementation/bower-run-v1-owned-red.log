!-- since 2026-09-30 -->\n  *You wrote: \"score job offers against my cv and tell me what im missing\"*\n- Passports, ID cards and certificates go to Areas / Documents; tick their line in Passport renewal. Never write document numbers. <!-- since 2026-09-30 -->\n  *You wrote: \"keep my id papers together\"*\n"}},{"meta":{"id":"f97","name":".bower","folder":true,"parents":["f1"],"modifiedTime":"2026-10-05T18:39:48.270Z","createdTime":"2026-10-05T18:39:48.270Z"},"trashed":false,"content":null},{"meta":{"id":"f98","name":"changes","folder":true,"parents":["f97"],"modifiedTime":"2026-10-05T18:39:48.271Z","createdTime":"2026-10-05T18:39:48.271Z"},"trashed":false,"content":null},{"meta":{"id":"f99","name":"questions.json","folder":false,"parents":["f97"],"modifiedTime":"2026-10-05T18:39:48.305Z","createdTime":"2026-10-05T18:39:48.272Z","size":895},"trashed":false,"content":{"text":"{\n  \"v\": 1,\n  \"questions\": [\n    {\n      \"id\": \"q1\",\n      \"text\": \"Flat 3, 12 Larkspur Lane and the new Wrenfield Road listing look like the same building. Keep one note for both?\",\n      \"yes\": \"Yes, merge\",\n      \"no\": \"No, keep both\",\n      \"about\": \"Projects/Flat hunt/Flat 3, 12 Larkspur Lane.md\",\n      \"askedAt\": 1791052788173\n    },\n    {\n      \"id\": \"q2\",\n      \"text\": \"Two receipts from Kittiwake Lettings look like the same holding deposit, paid twice. Keep both?\",\n      \"yes\": \"Keep both\",\n      \"no\": \"Keep one\",\n      \"askedAt\": 1791052788173\n    },\n    {\n      \"id\": \"q-saltmere\",\n      \"text\": \"The Saltmere receipts went to Money by month. Keep a copy of the list in the Saltmere weekend note too?\",\n      \"yes\": \"Yes, keep a copy\",\n      \"no\": \"No, Money is enough\",\n      \"about\": \"Projects/Saltmere weekend/Saltmere weekend.md\",\n      \"askedAt\": 1791225588184\n    }\n  ]\n}\n"}},{"meta":{"id":"f100","name":"suggestions.json","folder":false,"parents":["f97"],"modifiedTime":"2026-10-05T18:39:48.27