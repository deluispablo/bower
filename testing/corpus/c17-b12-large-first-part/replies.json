[
  {
    "kind": "tidy-intent",
    "v": 1,
    "things": [
      {
        "fileId": "$file:Garden notice.txt",
        "to": "Resources/Gardening",
        "name": "Garden notice.txt",
        "note": {
          "name": "Garden notice.md",
          "summary": "Alex can collect mulch at the amber gate.",
          "body": "Alex can collect mulch at the amber gate in Saltmere. The plot notes are in [[Gardening]]."
        }
      }
    ]
  },
  {
    "kind": "tidy-intent",
    "v": 1,
    "things": [],
    "maps": [
      {
        "requestId": "$request:change-1",
        "title": "Review Reading",
        "set": {
          "type": "concept",
          "folderId": "$folder:Resources/Reading",
          "recursive": false,
          "where": { "op": "eq", "property": "status", "value": "active" }
        },
        "ops": [{ "kind": "property", "key": "review_state", "mode": "set", "value": "reviewed" }],
        "question": {
          "text": "There are 201 reading notes. Start with the 200 most recent?",
          "yes": "Start with these",
          "no": "Leave them"
        }
      }
    ]
  },
  {
    "kind": "tidy-intent",
    "v": 1,
    "things": [],
    "maps": [
      {
        "requestId": "$request:press-4",
        "title": "Review the rest",
        "set": {
          "type": "concept",
          "folderId": "$folder:Resources/Reading",
          "recursive": false,
          "where": { "op": "eq", "property": "status", "value": "active" }
        },
        "ops": [{ "kind": "property", "key": "review_state", "mode": "set", "value": "reviewed" }]
      }
    ]
  }
]
