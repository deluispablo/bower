{
  "name": "@bower/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-headers.mjs && node scripts/check-size.mjs",
    "build:demo": "cross-env VITE_DEMO=1 vite build && node scripts/generate-headers.mjs && node scripts/check-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "pnpm exec vitest run --passWithNoTests",
    "size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "idb-keyval": "^6.3.0",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "cross-env": "^7.0.3",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
