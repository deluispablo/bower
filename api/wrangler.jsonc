{
  "name": "bower-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // One origin (TL-P3-06): the app's build is served as static assets, and the Worker runs
  // first only on its own paths, so the session cookie is first-party on Safari too.
  "assets": {
    "directory": "../dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/me", "/drive/*", "/vault", "/process", "/status", "/session", "/health", "/runner/*"]
  },
  "kv_namespaces": [{ "binding": "BOWER_KV", "id": "6969d46bffdb4b1e90d068f84235fbec" }],
  // Per-minute limits (TL-P3-14): Cloudflare's Rate Limiting binding, per location and eventually consistent.
  // Namespace ids are made up for this repo; each binding needs its own. A missing binding fails closed.
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "DRIVE_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "VAULT_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  // Logs for sign-in failures, free tier.
  "observability": { "enabled": true },
  // One SQLite-backed Durable Object per person, addressed by idFromName(sub).
  "durable_objects": { "bindings": [{ "name": "PERSON", "class_name": "Person" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Person"] }],
  // Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET, TOKEN_ENC_KEY) are never set here: `wrangler secret put` only.
  "vars": {
    // One origin (TL-P3-06): the same placeholder for both; the deploy passes the real one with --var.
    "APP_ORIGIN": "https://app.example.com",
    "API_ORIGIN": "https://app.example.com",
    "APP_VERSION": "0.1.0",
    "GITHUB_REPO": "OWNER/REPO",
    "DAILY_RUN_LIMIT": "100",
    "TEMPLATE_FOLDER_NAME": "Bower"
  }
}
