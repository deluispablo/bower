{
  "name": "bower-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "kv_namespaces": [{ "binding": "BOWER_KV", "id": "KV_NAMESPACE_ID" }],
  // Secrets (SESSION_SECRET, TOKEN_ENC_KEY, ...) are never set here: `wrangler secret put` only.
  "vars": {
    "APP_ORIGIN": "https://app.example.com",
    "API_ORIGIN": "https://api.example.com",
    "APP_VERSION": "0.1.0",
    "GITHUB_REPO": "OWNER/REPO",
    "VAPID_SUBJECT": "mailto:you@example.com",
    "DAILY_RUN_LIMIT": "100",
    "DEFAULT_MAX_TURNS": "60",
    "TEMPLATE_FOLDER_NAME": "Bower"
  }
}
